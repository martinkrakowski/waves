{
  "name": "@hexagen-monaco/waves-client",
  "version": "0.3.0",
  "description": "The waves CLI: register a project or a list of them, then push its wave snapshots and its status, and delete a wave.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "waves": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hexagen-monaco/waves-contract": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinkrakowski/waves.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/martinkrakowski/waves#readme",
  "engines": {
    "node": ">=22.7.0"
  }
}
